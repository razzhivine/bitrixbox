#!/usr/bin/env bash
# BitrixBox — единая команда для локального Битрикса:  ./bx <команда>   (bx help — список)
# Чтобы вызывать просто `bx` из любой папки:  ./bx install-cli
set -euo pipefail

# находим папку проекта, даже если вызвали через симлинк
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ $SRC != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd -P "$(dirname "$SRC")" && pwd)"
cd "$ROOT"

# Docker Desktop на macOS: запустить и дождаться, если он выключен
ensure_docker() {
  docker info >/dev/null 2>&1 && return 0
  if [ "$(uname)" != Darwin ]; then echo "Docker не запущен. Запустите его и повторите."; exit 1; fi
  echo "Docker не запущен — запускаю Docker Desktop..."
  open -a Docker
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 3; done
  echo "Docker не поднялся за 3 минуты"; exit 1
}

# Совместимость со старыми установками: раньше Compose брал имя проекта из имени папки.
# Если в .env нет BX_PROJECT, записываем то же самое имя, чтобы контейнеры и тома не «потерялись».
if [ -f .env ] && ! grep -q '^BX_PROJECT=' .env; then
  legacy="$(basename "$ROOT" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]//g')"
  printf 'BX_PROJECT=%s\n' "${legacy:-bitrixbox}" >> .env
fi

# Пройти мастер установки Битрикса без браузера (данные базы берутся из .env)
run_wizard() {
  get() { grep "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2-; }
  if [ "$(get START_PATH)" = "/bitrixsetup.php" ]; then
    echo "Веб-установщик (bitrixsetup.php) автоматически не проходится: редакцию в нём выбирают в браузере."
    echo "Выберите редакцию из архива: bx setup --edition standard (или start, small_business, business)."
    return 1
  fi
  command -v python3 >/dev/null || { echo "Для bx install нужен python3"; return 1; }
  python3 scripts/wizard.py --url "http://localhost:$(get HTTP_PORT)" \
    --db-name "$(get DB_NAME)" --db-user "$(get DB_USER)" --db-password "$(get DB_PASSWORD)" "$@"
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in --version|-v) cmd=version ;; esac

case "$cmd" in
  setup)
    # всё с нуля: Docker -> окружение -> HTTPS -> подсказка
    #   bx setup                        с вопросами
    #   bx setup --defaults             без вопросов (флаги init: --edition, --php, --http-port ...; HTTPS по умолчанию включается)
    #   bx setup --no-https | --https   решить про HTTPS заранее;  --redirect  включить редирект http -> https
    #   bx setup --install              ещё и пройти мастер установки Битрикса без браузера (редакция не web)
    #   bx setup --install --clean      ... и сразу убрать демо-данные и лишние модули (как bx clean --all-modules)
    HTTPS_MODE=ask; HTTPS_ARGS=(); INIT_ARGS=(); DO_INSTALL=0; DO_CLEAN=0; WIZ_ARGS=()
    while [ $# -gt 0 ]; do
      case $1 in
        --install)  DO_INSTALL=1 ;;
        --clean)    DO_CLEAN=1 ;;
        --register) WIZ_ARGS+=(--register) ;;
        --skip-updates) WIZ_ARGS+=(--skip-updates) ;;
        --reg-name|--reg-surname|--reg-email|--admin-login|--admin-password|--admin-email|--admin-name|--admin-surname|--solution|--demo)
                    WIZ_ARGS+=("$1" "${2:?у $1 нужно значение}"); shift ;;
        --https)    HTTPS_MODE=yes ;;
        --no-https) HTTPS_MODE=no ;;
        --redirect) HTTPS_ARGS+=(--redirect) ;;
        --defaults|-y) INIT_ARGS+=("$1"); HTTPS_ARGS+=(--defaults); [ "$HTTPS_MODE" = ask ] && HTTPS_MODE=yes ;;
        *) INIT_ARGS+=("$1") ;;
      esac
      shift
    done
    if [ "$DO_CLEAN" = 1 ] && [ "$DO_INSTALL" = 0 ]; then echo "--clean работает только вместе с --install"; exit 1; fi
    ensure_docker
    bash scripts/init.sh ${INIT_ARGS[@]+"${INIT_ARGS[@]}"}
    if [ "$HTTPS_MODE" = ask ]; then
      echo
      read -r -p "Включить HTTPS? [Y/n]: " yn
      [[ $yn =~ ^[nN]$ ]] && HTTPS_MODE=no || HTTPS_MODE=yes
    fi
    [ "$HTTPS_MODE" = yes ] && bash scripts/https.sh ${HTTPS_ARGS[@]+"${HTTPS_ARGS[@]}"}
    if [ "$DO_INSTALL" = 1 ]; then
      echo; echo "== Установка Битрикса (мастер без браузера) =="
      run_wizard ${WIZ_ARGS[@]+"${WIZ_ARGS[@]}"}
      if [ "$DO_CLEAN" = 1 ]; then
        echo; echo "== Очистка демо-данных и лишних модулей =="
        bash scripts/clean.sh --yes --all-modules --drop-tables --module-files
      fi
      cat <<'MSG'

Дальше (по желанию):
  bx cron on     агенты и почта Битрикса по расписанию, а не на хитах страниц
  bx clean       убрать демо-данные
MSG
    else
      cat <<'MSG'

Дальше:
  1. Откройте адрес из вывода выше и пройдите установщик Битрикса в браузере
     (или выполните  bx install  — мастер пройдёт сам).
  2. Когда он закончит:
       bx cron on     агенты и почта Битрикса по расписанию, а не на хитах страниц
       bx clean       очистить демо-данные
MSG
    fi
    ;;
  init)     ensure_docker; exec bash scripts/init.sh "$@" ;;
  https)    ensure_docker; exec bash scripts/https.sh "$@" ;;
  clean)    ensure_docker; exec bash scripts/clean.sh "$@" ;;
  install)  ensure_docker; run_wizard "$@" ;;
  passwords) ensure_docker; exec bash scripts/passwords.sh "$@" ;;
  update)   ensure_docker; exec bash scripts/update.sh "$@" ;;
  doctor)   exec bash scripts/doctor.sh ;;
  cron)     ensure_docker; exec bash scripts/cron.sh "$@" ;;
  cache-clear)
    ensure_docker
    docker compose exec -T php php < scripts/php/cache.php 2>&1 | grep -a "Кеш"
    ;;
  sql)
    ensure_docker
    # без аргументов — консоль MySQL, с аргументом — выполнить запрос: bx sql "select count(*) from b_user"
    if [ $# -gt 0 ]; then
      docker compose exec -T db sh -c 'M=$(command -v mysql || command -v mariadb); "$M" -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE" --table -e "$0" 2>&1 | grep -v "Using a password"' "$*" </dev/null
    else
      docker compose exec db sh -c 'M=$(command -v mysql || command -v mariadb); "$M" -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE"'
    fi
    ;;
  php)      ensure_docker; docker compose exec -u www-data php php "$@" ;;
  open)
    . ./.env 2>/dev/null || true
    case "${1:-site}" in
      site)  if [ -f docker/nginx/https/server.conf ]; then url="https://localhost:${HTTPS_PORT:-8443}/"; else url="http://localhost:${HTTP_PORT:-8080}/"; fi ;;
      admin) if [ -f docker/nginx/https/server.conf ]; then url="https://localhost:${HTTPS_PORT:-8443}/bitrix/admin/"; else url="http://localhost:${HTTP_PORT:-8080}/bitrix/admin/"; fi ;;
      mail)  url="http://localhost:${MAIL_PORT:-8025}/" ;;
      db)    url="http://localhost:${ADMINER_PORT:-8081}/?server=db&username=${DB_USER:-bitrix}&db=${DB_NAME:-bitrix}" ;;
      *) echo "Используйте: bx open site | admin | mail | db"; exit 1 ;;
    esac
    echo "$url"; open "$url" 2>/dev/null || true
    ;;
  backup)   ensure_docker; exec bash scripts/backup.sh backup "$@" ;;
  restore)  ensure_docker; exec bash scripts/backup.sh restore "$@" ;;
  debug)
    ensure_docker
    docker compose exec -T -e MODE="${1:-status}" php php < scripts/php/debug.php
    ;;
  up)       ensure_docker; docker compose up -d --build "$@" ;;
  down)     docker compose down "$@" ;;
  restart)  docker compose restart "$@" ;;
  status)   docker compose ps "$@" ;;
  logs)     docker compose logs -f "$@" ;;
  shell)    docker compose exec php bash ;;
  reset)
    echo "Это удалит контейнеры, базу, файлы сайта (том www) и .env. Папка local/ останется."
    read -r -p "Введите yes для подтверждения: " yn
    [ "$yn" = yes ] || { echo "Отменено"; exit 0; }
    docker compose down -v
    rm -rf .env
    ;;
  install-cli)
    target="${1:-/opt/homebrew/bin}"
    [ -d "$target" ] && [ -w "$target" ] || { echo "Нет доступа на запись в $target. Укажите другую папку из PATH: ./bx install-cli ~/.local/bin"; exit 1; }
    ln -sf "$ROOT/bx" "$target/bx"
    echo "Готово: команда 'bx' доступна из любой папки ($target/bx)"
    ;;
  version)  echo "BitrixBox $(cat "$ROOT/VERSION" 2>/dev/null || echo dev)" ;;
  help|-h|--help)
    cat <<'HELP'
Использование: bx <команда>

  setup        всё с нуля одной командой: Docker, окружение, HTTPS
  init         интерактивная настройка и запуск (редакция, БД, пароли, порты)
  install      пройти мастер установки Битрикса без браузера (--admin-login, --admin-password, --solution, --register --reg-name --reg-surname --reg-email)
  https        включить HTTPS (bx https --off — выключить)
  clean        очистить демо-данные, остатки и модули (bx clean --dry-run — только план)
  up / down    запустить / остановить контейнеры
  cron         агенты и почта по расписанию: bx cron on | off | status
  cache-clear  сбросить кеш Битрикса
  sql          консоль MySQL; bx sql "запрос" — выполнить запрос
  php          php в контейнере: bx php -v
  open         открыть в браузере: site | admin | mail (письма) | db (Adminer)
  backup       снимок окружения (база, файлы, local); bx backup list — список
  restore      восстановить из снимка (текущее состояние сохранит заранее)
  passwords    bx passwords rotate — сменить пароли БД (root и пользователь) везде: БД, .env, Битрикс
  update       обновить Битрикс (bx update --check — только показать, что доступно)
  doctor       диагностика окружения: Docker, порты, сайт, HTTPS, Битрикс, диск
  debug        отладка Битрикса: bx debug on | off | status
  restart      перезапустить контейнеры
  status       состояние контейнеров
  logs         логи
  shell        консоль в php-контейнере
  reset        снести всё и начать заново (спросит подтверждение)
  version      версия BitrixBox (bx --version)
  install-cli  сделать команду `bx` доступной из любой папки
HELP
    ;;
  *) echo "Неизвестная команда: $cmd (список: bx help)"; exit 1 ;;
esac
